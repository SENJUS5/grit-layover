# Copy this file to .env.local and fill in both values from your Supabase
# project (dashboard: Connect, or Project Settings > API).
# Only these two public values belong here. Never add the service_role /
# secret key: the app does not need it, and anything NEXT_PUBLIC_ is sent to
# every browser.
NEXT_PUBLIC_SUPABASE_URL=
# The anon key (legacy JWT) or the publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
